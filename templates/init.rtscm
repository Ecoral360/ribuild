(define-package  
  ; don't change the ribuild-version yourself, automatically set by ribuild
  (ribuild-version "${ribuild-version}")

  (name "${pkg-name}")
  (description "Add your description here !")
  (version "0.1.0")
  (authors ("${author}"))

  (entry main) ; specify the entry point of the program
  (output-dir "build") ; specify the dir where to put the output of targets

  (dependency-dir "lib")
  (dependencies
    ;; (srfi-180 (github "Ecoral360/ribbit-srfi-180")) ;; example
    )

  ;; libraries have those form accepted:
  ;; (ribbit "std-lib"), "path/to/file.scm", "directory/**", dependency-name
  (includes
    (ribbit "r4rs")
    "src/**")

  (features ; sets the features for all the targets
    +prim-no-arity  ; prefix `+` sets the feature value to #t
    +v-port
    ;-other-feature ; prefix `-` sets the feature value to #f
    )

  (targets
    (target "c" ; adds c as a target of the package
      (output "${pkg-name}.c")
      (exe "${pkg-name}.c.exe"))

    (target "js" ; adds javascript as a target of the package
      (exe "${pkg-name}.js.exe"))

    (target "py" ; adds python as a target of the package
      (exe "${pkg-name}.py.exe"))))
